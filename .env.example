# vulnscan configuration. Copy this file to .env (next to where you run vulnscan,
# or pass --env-file) and edit. Every value is optional: the values shown are the
# defaults unless the comment says otherwise. Environment variables with the same
# names override this file, and command line flags override both.

# ---- Project ------------------------------------------------------------------

# Directory to scan (--path). Default: the current directory.
VULNSCAN_PROJECT_PATH=.

# Include dev / test / optional dependencies.
VULNSCAN_INCLUDE_DEV=true

# Also scan packages that lock files record but no manifest declares. They are
# marked as transitive, with the packages that require them (--transitive).
VULNSCAN_TRANSITIVE=false

# Also query packages whose version cannot be determined. This reports every
# advisory ever published for them, so it is noisy.
VULNSCAN_QUERY_UNKNOWN_VERSIONS=false

# Directories to skip when looking for manifests, comma separated (--ignore).
# A bare name (legacy) matches a directory of that name anywhere; a path
# (web/app/plugins/graveyard) is relative to the project root; both accept
# shell wildcards (*-old). A .vulnscanignore file in the project root, one
# pattern per line, is always read as well. Default: none.
VULNSCAN_IGNORE_DIRS=

# Invenio / InvenioRDM: treat webpack.py theme bundles as npm constraint sources
# and remediation targets. auto | on | off (--invenio-webpack).
VULNSCAN_INVENIO_WEBPACK=auto
# Site overlay webpack.py always updated on npm remediate (optional; auto-detected
# as the unique site/*/webpack.py when unset).
# VULNSCAN_INVENIO_WEBPACK_OVERLAY=site/kcworks/webpack.py

# ---- Output -------------------------------------------------------------------

# Directory for feeds, reports and state files (--feed-dir).
VULNSCAN_FEED_DIR=./feeds
VULNSCAN_RSS_FILE=vulns.rss.xml
VULNSCAN_ATOM_FILE=vulns.atom.xml
# Records when each feed entry was first seen (its published date).
VULNSCAN_STATE_FILE=vulnscan-state.json
# Report filenames used by --markdown / --text without an argument and by the
# TUI's "e" key.
VULNSCAN_MARKDOWN_FILE=vulns.md
VULNSCAN_TEXT_FILE=vulns.txt

# Feed metadata. FEED_LINK is the public base URL the feed files are served
# from (for example https://example.com/feeds/); it is used for the feeds' self
# links and may be left empty.
VULNSCAN_FEED_TITLE=Vulnerable dependencies
VULNSCAN_FEED_DESCRIPTION=Direct dependencies with known security advisories
VULNSCAN_FEED_LINK=

# ---- Advisory sources ---------------------------------------------------------

# OSV.dev, used for PyPI and Packagist packages. No key needed.
VULNSCAN_OSV_URL=https://api.osv.dev

# HTTP timeout in seconds, for every service vulnscan talks to.
VULNSCAN_TIMEOUT=30

# Wordfence Intelligence, used for WordPress core, plugins and themes. Get a
# free key from your wordfence.com account: Wordfence Intelligence >
# Integrations. Without a key WordPress packages are listed but not checked.
VULNSCAN_WORDFENCE_API_KEY=
VULNSCAN_WORDFENCE_URL=https://www.wordfence.com/api/intelligence/v3
# How long the cached feed stays fresh before a conditional refresh is tried.
VULNSCAN_WORDFENCE_TTL_HOURS=24
# Never contact the Wordfence API more often than this, even after a failure.
VULNSCAN_WORDFENCE_MIN_INTERVAL_MINUTES=30
# NVD (nvd.nist.gov), used for the software inside container images named in
# Dockerfiles and Compose files. No key needed; a free key (see
# nvd.nist.gov/developers/request-an-api-key) raises the rate limit from 5 to
# 50 requests per 30 seconds.
VULNSCAN_NVD_API_KEY=
VULNSCAN_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# How long a cached NVD answer for one image version stays fresh.
VULNSCAN_NVD_TTL_HOURS=24
# Map images vulnscan does not recognise to the CPE vendor:product NVD records
# CVEs against, comma separated. Overrides the built-in map for known images.
# VULNSCAN_IMAGE_PRODUCTS=myorg/app=myorg:app,ghcr.io/example/tool=example:tool

# Where the Wordfence feed and NVD answers are cached. Default:
# $XDG_CACHE_HOME/vulnscan, or ~/.cache/vulnscan when XDG_CACHE_HOME is unset.
#VULNSCAN_CACHE_DIR=/var/cache/vulnscan

# ---- Notifications (vulnscan --ntfy and/or --msteams) -------------------------

# Minutes between scans in notification mode (--interval).
VULNSCAN_INTERVAL_MINUTES=60

# ntfy (--ntfy). Topic is required. Authenticate with an access token or with a
# user and password; the token wins if both are set.
VULNSCAN_NTFY_SERVER=https://ntfy.sh
VULNSCAN_NTFY_TOPIC=
VULNSCAN_NTFY_TOKEN=
VULNSCAN_NTFY_USER=
VULNSCAN_NTFY_PASSWORD=
# Records which advisories ntfy has already received (inside VULNSCAN_FEED_DIR).
VULNSCAN_NTFY_STATE_FILE=ntfy-state.json

# Microsoft Teams (--msteams). The URL of a Workflows flow in the target channel
# that posts the received Adaptive Card ("Send webhook alerts to a channel").
VULNSCAN_MSTEAMS_WEBHOOK_URL=
# Records which advisories Teams has already received (inside VULNSCAN_FEED_DIR).
VULNSCAN_MSTEAMS_STATE_FILE=msteams-state.json


# ---- Forward-check / preflight ------------------------------------------------
VULNSCAN_FRESH_HOURS=24
VULNSCAN_STRICT_FRESH=false
VULNSCAN_PREFLIGHT_IGNORE=
VULNSCAN_PREFLIGHT_RSS_FILE=preflight.rss.xml
VULNSCAN_PREFLIGHT_ATOM_FILE=preflight.atom.xml
VULNSCAN_PREFLIGHT_STATE_FILE=preflight-state.json
VULNSCAN_PREFLIGHT_MARKDOWN_FILE=preflight.md
VULNSCAN_PREFLIGHT_TEXT_FILE=preflight.txt
