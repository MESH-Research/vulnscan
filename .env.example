# Copy to .env and adjust. Every value is optional; CLI flags override these.

# Project directory to scan (default: current directory)
VULNSCAN_PROJECT_PATH=/path/to/project

# Where feeds and the first-seen state file are written (default: ./feeds)
VULNSCAN_FEED_DIR=./feeds
VULNSCAN_RSS_FILE=vulns.rss.xml
VULNSCAN_ATOM_FILE=vulns.atom.xml
VULNSCAN_STATE_FILE=vulnscan-state.json

# Feed metadata. FEED_LINK is the public base URL the feed files are served from;
# it is used for the feeds' self links and may be left empty.
VULNSCAN_FEED_TITLE=Vulnerable dependencies
VULNSCAN_FEED_DESCRIPTION=Direct dependencies with known security advisories
VULNSCAN_FEED_LINK=https://example.com/feeds/

# OSV.dev API
VULNSCAN_OSV_URL=https://api.osv.dev
VULNSCAN_TIMEOUT=30

# Include dev/test/optional dependencies (default: true)
VULNSCAN_INCLUDE_DEV=true

# Wordfence Intelligence (WordPress core, plugins, themes). Free key from your
# wordfence.com account dashboard under Wordfence Intelligence > Integrations.
VULNSCAN_WORDFENCE_API_KEY=
VULNSCAN_WORDFENCE_URL=https://www.wordfence.com/api/intelligence/v3
VULNSCAN_WORDFENCE_TTL_HOURS=24
# Never contact the Wordfence API more often than this, even on failures
VULNSCAN_WORDFENCE_MIN_INTERVAL_MINUTES=30
# Where the Wordfence feed is cached (default: $XDG_CACHE_HOME/vulnscan or ~/.cache/vulnscan)
#VULNSCAN_CACHE_DIR=/var/cache/vulnscan

# Extra directory names to skip when looking for manifests (comma separated)
VULNSCAN_IGNORE_DIRS=

# Report filenames (written into VULNSCAN_FEED_DIR by --markdown / --text or the TUI's 'e' key)
VULNSCAN_MARKDOWN_FILE=vulns.md
VULNSCAN_TEXT_FILE=vulns.txt

# Query packages whose version cannot be determined (reports every advisory
# ever published for them, so this is noisy; default: false)
VULNSCAN_QUERY_UNKNOWN_VERSIONS=false
